  "devDependencies": {
    "@aila/typescript-config": "workspace:*",
    "@types/node": "catalog:types",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:vite",
    "oxlint": "catalog:lint",
    "typescript": "catalog:",
    "vite": "catalog:vite"
